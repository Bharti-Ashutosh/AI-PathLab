# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?appName=Cluster0

# JWT secret for token signing (use a long random string)
JWT_SECRET_KEY=your_long_random_jwt_secret_here

# Express server port
PORT=5000

# Stripe secret key (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Frontend URL (used in Stripe success redirect and CORS)
CLIENT_SITE_URL=http://localhost:5173

# Gmail credentials for nodemailer (contact form & forgot-password emails)
# Use a Gmail App Password, not your main account password
USER=your_email@gmail.com
APP_PASS=your_gmail_app_password_here
